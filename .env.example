# =============================================================================
# Public env vars (Vite bundles these into the client at build time)
# NEVER put secrets here. These are visible in the browser.
# =============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (sprint 3, anti-abuse na career page pública)
# VITE_TURNSTILE_SITE_KEY=

# =============================================================================
# Server-only secrets (Supabase Edge Functions)
# NEVER commit. Configure via: supabase secrets set ANTHROPIC_API_KEY=...
# =============================================================================

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TURNSTILE_SECRET_KEY=
